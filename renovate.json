{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "homebrew": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track versions pinned with a # renovate: comment in workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+VERSION=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
